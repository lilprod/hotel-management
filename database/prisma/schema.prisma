// Hotel Management SaaS — Prisma schema (doc 04 — modèle de données).
// Conventions: UUID v7 ids, snake_case tables/columns, money = BigInt minor units + currency CHAR(3),
// nights = DATE (arrival included, departure excluded), events = timestamptz.
// RLS policies, grants, exclusion constraints, partial indexes and immutability triggers live in
// the hand-written migration "*_rls_security" (Prisma cannot express them).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ======================================================================
// §1 Plateforme (sans RLS — accès admin uniquement)
// ======================================================================

model PlatformUser {
  id            String       @id @default(uuid(7)) @db.Uuid
  email         String       @unique
  passwordHash  String       @map("password_hash")
  name          String
  role          PlatformRole
  totpSecretEnc String?      @map("totp_secret_enc")
  isActive      Boolean      @default(true) @map("is_active")
  lastLoginAt   DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_users")
}

model Plan {
  id            String         @id @default(uuid(7)) @db.Uuid
  code          String         @unique
  name          String
  description   String?
  trialDays     Int            @default(0) @map("trial_days")
  sort          Int            @default(0)
  isPublic      Boolean        @default(true) @map("is_public")
  isActive      Boolean        @default(true) @map("is_active")
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  planPrices    PlanPrice[]
  planFeatures  PlanFeature[]
  planQuotas    PlanQuota[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanPrice {
  id           String       @id @default(uuid(7)) @db.Uuid
  planId       String       @map("plan_id") @db.Uuid
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  billingCycle BillingCycle @map("billing_cycle")
  currency     String       @default("XOF") @db.Char(3)
  amount       BigInt
  validFrom    DateTime     @map("valid_from") @db.Date
  validTo      DateTime?    @map("valid_to") @db.Date
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([planId, billingCycle, currency])
  @@map("plan_prices")
}

model PlanFeature {
  id         String   @id @default(uuid(7)) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

model PlanQuota {
  id        String   @id @default(uuid(7)) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  quotaKey  String   @map("quota_key")
  limit     Int? // NULL = illimité
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([planId, quotaKey])
  @@map("plan_quotas")
}

model Tenant {
  id                      String                   @id @default(uuid(7)) @db.Uuid
  slug                    String                   @unique
  name                    String
  legalName               String?                  @map("legal_name")
  country                 String                   @db.Char(2)
  phone                   String?
  email                   String?
  status                  TenantStatus             @default(ACTIVE)
  defaultLocale           String                   @default("fr") @map("default_locale")
  defaultCurrency         String                   @default("XOF") @map("default_currency") @db.Char(3)
  timezone                String
  allowImpersonation      Boolean                  @default(false) @map("allow_impersonation")
  notes                   String?
  tags                    String[]
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantDomains           TenantDomain[]
  tenantOverrides         TenantOverride[]
  subscriptions           Subscription[]
  platformInvoices        PlatformInvoice[]
  payments                Payment[]
  tenantCredits           TenantCredit[]
  paymentDeclarations     PaymentDeclaration[]
  supportTickets          SupportTicket[]
  sequences               Sequence[]
  tenantAddons            TenantAddon[]
  couponRedemptions       CouponRedemption[]
  users                   User[]
  userProperties          UserProperty[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  userRoles               UserRole[]
  securityPolicy          SecurityPolicy?
  sessions                Session[]
  auditLogs               AuditLog[]
  branding                Branding?
  messageTemplates        MessageTemplate[]
  legalAcceptances        LegalAcceptance[]
  properties              Property[]
  roomTypes               RoomType[]
  rooms                   Room[]
  roomBlocks              RoomBlock[]
  taxes                   Tax[]
  ratePlans               RatePlan[]
  seasons                 Season[]
  rates                   Rate[]
  policies                Policy[]
  guests                  Guest[]
  companies               Company[]
  reservations            Reservation[]
  reservationRooms        ReservationRoom[]
  unitNights              UnitNight[]
  waitlistEntries         WaitlistEntry[]
  reservationGuests       ReservationGuest[]
  groups                  Group[]
  stays                   Stay[]
  policeRecords           PoliceRecord[]
  folios                  Folio[]
  folioLines              FolioLine[]
  invoices                Invoice[]
  folioPayments           FolioPayment[]
  cashSessions            CashSession[]
  cashMovements           CashMovement[]
  nightAudits             NightAudit[]
  hkTasks                 HkTask[]
  products                Product[]
  outlets                 Outlet[]
  warehouses              Warehouse[]
  stockMovements          StockMovement[]
  stockCounts             StockCount[]
  stockCountLines         StockCountLine[]
  suppliers               Supplier[]
  purchaseOrders          PurchaseOrder[]
  files                   File[]
  outboxEvents            OutboxEvent[]
  guestAccounts           GuestAccount[]
  guestRequests           GuestRequest[]
  depositDeclarations     DepositDeclaration[]
  guestPreferences        GuestPreference[]
  communications          Communication[]
  consents                Consent[]
  loyaltyPrograms         LoyaltyProgram[]
  loyaltyTiers            LoyaltyTier[]
  loyaltyAccounts         LoyaltyAccount[]
  loyaltyTransactions     LoyaltyTransaction[]
  departments             Department[]
  employees               Employee[]
  shiftTemplates          ShiftTemplate[]
  staffSchedules          StaffSchedule[]
  timeEntries             TimeEntry[]
  leaves                  Leave[]
  tasks                   Task[]
  conversations           Conversation[]
  conversationMembers     ConversationMember[]
  messages                Message[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  floorPlans              FloorPlan[]
  diningTables            DiningTable[]
  menuCategories          MenuCategory[]
  menuItems               MenuItem[]
  dailySpecials           DailySpecial[]
  orders                  Order[]
  orderItems              OrderItem[]
  tableReservations       TableReservation[]
  spaServices             SpaService[]
  therapists              Therapist[]
  treatmentRooms          TreatmentRoom[]
  appointments            Appointment[]
  treatmentRecords        TreatmentRecord[]
  packages                Package[]
  packageComponents       PackageComponent[]
  activities              Activity[]
  activitySlots           ActivitySlot[]
  activityBookings        ActivityBooking[]
  inventoryItems          InventoryItem[]
  stockLevels             StockLevel[]
  recipes                 Recipe[]
  recipeLines             RecipeLine[]
  purchaseOrderLines      PurchaseOrderLine[]
  goodsReceipts           GoodsReceipt[]
  goodsReceiptLines       GoodsReceiptLine[]
  reorderSuggestions      ReorderSuggestion[]
  assets                  Asset[]
  maintenanceRequests     MaintenanceRequest[]
  workOrders              WorkOrder[]
  preventivePlans         PreventivePlan[]
  roomStatusHistories     RoomStatusHistory[]
  settings                Setting[]
  customFieldDefinitions  CustomFieldDefinition[]
  lookupValues            LookupValue[]
  fiscalDocuments         FiscalDocument[]
  exchangeRates           ExchangeRate[]
  importJobs              ImportJob[]
  importRows              ImportRow[]
  ledgerAccounts          LedgerAccount[]
  accountMappings         AccountMapping[]
  accountingExports       AccountingExport[]
  periodClosings          PeriodClosing[]
  minibarTemplates        MinibarTemplate[]
  minibarCounts           MinibarCount[]
  lostFoundItems          LostFoundItem[]
  apiKeys                 ApiKey[]
  webhookSubscriptions    WebhookSubscription[]
  webhookDeliveries       WebhookDelivery[]
  dailyStatsProperties    DailyStatsProperty[]
  dailyStatsDepartments   DailyStatsDepartment[]

  @@map("tenants")
}

model TenantDomain {
  id         String     @id @default(uuid(7)) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  hostname   String     @unique
  type       DomainType
  verifiedAt DateTime?  @map("verified_at") @db.Timestamptz(6)
  tlsStatus  TlsStatus  @default(PENDING) @map("tls_status")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("tenant_domains")
}

model TenantOverride {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  kind      OverrideKind
  key       String
  value     Json
  endsAt    DateTime?    @map("ends_at") @db.Timestamptz(6)
  note      String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, kind, key])
  @@map("tenant_overrides")
}

model Subscription {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  planId             String              @map("plan_id") @db.Uuid
  plan               Plan                @relation(fields: [planId], references: [id])
  billingCycle       BillingCycle        @map("billing_cycle")
  status             SubscriptionStatus  @default(TRIALING)
  trialEndsAt        DateTime?           @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime?           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?           @map("current_period_end") @db.Timestamptz(6)
  graceEndsAt        DateTime?           @map("grace_ends_at") @db.Timestamptz(6)
  cancelAt           DateTime?           @map("cancel_at") @db.Timestamptz(6)
  priceSnapshot      Json?               @map("price_snapshot")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptionEvents SubscriptionEvent[]
  platformInvoices   PlatformInvoice[]
  couponRedemptions  CouponRedemption[]

  @@index([tenantId, status])
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String              @id @default(uuid(7)) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus  @map("to_status")
  reason         String?
  actor          String?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subscriptionId])
  @@map("subscription_events")
}

model PlatformInvoice {
  id                   String                @id @default(uuid(7)) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  subscriptionId       String?               @map("subscription_id") @db.Uuid
  subscription         Subscription?         @relation(fields: [subscriptionId], references: [id])
  number               String                @unique
  issueDate            DateTime              @map("issue_date") @db.Date
  dueDate              DateTime              @map("due_date") @db.Date
  periodStart          DateTime?             @map("period_start") @db.Date
  periodEnd            DateTime?             @map("period_end") @db.Date
  currency             String                @default("XOF") @db.Char(3)
  subtotal             BigInt
  tax                  BigInt                @default(0)
  total                BigInt
  amountPaid           BigInt                @default(0) @map("amount_paid")
  status               PlatformInvoiceStatus @default(ISSUED)
  pdfFileId            String?               @map("pdf_file_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  platformInvoiceLines PlatformInvoiceLine[]
  paymentAllocations   PaymentAllocation[]

  @@index([tenantId, status])
  @@index([subscriptionId])
  @@map("platform_invoices")
}

model PlatformInvoiceLine {
  id         String          @id @default(uuid(7)) @db.Uuid
  invoiceId  String          @map("invoice_id") @db.Uuid
  invoice    PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label      String
  qty        Int             @default(1)
  unitAmount BigInt          @map("unit_amount")
  amount     BigInt
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([invoiceId])
  @@map("platform_invoice_lines")
}

model Payment {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  amount             BigInt
  currency           String              @default("XOF") @db.Char(3)
  method             PaymentMethod
  reference          String?             @db.VarChar(100)
  paidAt             DateTime            @map("paid_at") @db.Date
  status             PaymentStatus       @default(PENDING_VALIDATION)
  provider           String              @default("manual")
  providerPayload    Json?               @map("provider_payload")
  attachmentFileId   String?             @map("attachment_file_id") @db.Uuid
  note               String?
  recordedBy         String?             @map("recorded_by") @db.Uuid
  validatedBy        String?             @map("validated_by") @db.Uuid
  validatedAt        DateTime?           @map("validated_at") @db.Timestamptz(6)
  reversedBy         String?             @map("reversed_by") @db.Uuid
  reversedAt         DateTime?           @map("reversed_at") @db.Timestamptz(6)
  reversalReason     String?             @map("reversal_reason")
  receiptNumber      String?             @unique @map("receipt_number")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  paymentAllocations PaymentAllocation[]
  tenantCredits      TenantCredit[]
  paymentDeclaration PaymentDeclaration?

  @@index([tenantId, paidAt])
  @@index([method, reference])
  @@map("payments")
}

model PaymentAllocation {
  id        String          @id @default(uuid(7)) @db.Uuid
  paymentId String          @map("payment_id") @db.Uuid
  payment   Payment         @relation(fields: [paymentId], references: [id])
  invoiceId String          @map("invoice_id") @db.Uuid
  invoice   PlatformInvoice @relation(fields: [invoiceId], references: [id])
  amount    BigInt
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model TenantCredit {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  sourcePaymentId String?  @map("source_payment_id") @db.Uuid
  sourcePayment   Payment? @relation(fields: [sourcePaymentId], references: [id])
  amount          BigInt
  currency        String   @default("XOF") @db.Char(3)
  consumedAmount  BigInt   @default(0) @map("consumed_amount")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([sourcePaymentId])
  @@map("tenant_credits")
}

model PaymentDeclaration {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  paymentId        String?           @unique @map("payment_id") @db.Uuid
  payment          Payment?          @relation(fields: [paymentId], references: [id])
  amount           BigInt
  currency         String            @default("XOF") @db.Char(3)
  method           PaymentMethod
  reference        String?           @db.VarChar(100)
  paidAt           DateTime          @map("paid_at") @db.Date
  attachmentFileId String?           @map("attachment_file_id") @db.Uuid
  note             String?
  status           DeclarationStatus @default(SUBMITTED)
  submittedBy      String?           @map("submitted_by") @db.Uuid
  reviewedBy       String?           @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  rejectReason     String?           @map("reject_reason")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@map("payment_declarations")
}

model PlatformSetting {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

model Announcement {
  id              String    @id @default(uuid(7)) @db.Uuid
  title           String
  body            String
  severity        String    @default("INFO")
  targetTenantIds String[]  @map("target_tenant_ids") @db.Uuid
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("announcements")
}

model SupportTicket {
  id              String              @id @default(uuid(7)) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  subject         String
  status          SupportTicketStatus @default(OPEN)
  priority        Priority            @default(NORMAL)
  openedBy        String?             @map("opened_by") @db.Uuid
  assignedTo      String?             @map("assigned_to") @db.Uuid
  closedAt        DateTime?           @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  supportMessages SupportMessage[]

  @@index([tenantId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id         String            @id @default(uuid(7)) @db.Uuid
  ticketId   String            @map("ticket_id") @db.Uuid
  ticket     SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType SupportAuthorType @map("author_type")
  authorId   String            @map("author_id") @db.Uuid
  body       String
  fileIds    String[]          @map("file_ids") @db.Uuid
  isInternal Boolean           @default(false) @map("is_internal")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ticketId])
  @@map("support_messages")
}

model PlatformAuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?  @db.Inet
  userAgent String?  @map("user_agent")
  at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([at])
  @@map("platform_audit_logs")
}

model Sequence {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  scope     String // "platform" ou "<tenant_id>:<property_id>"
  key       String
  year      Int      @default(0)
  nextValue BigInt   @default(1) @map("next_value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, key, year])
  @@index([tenantId])
  @@map("sequences")
}

// ======================================================================
// §3 ter — catalogue commercial, légal et fiscal (plateforme)
// ======================================================================

model Addon {
  id           String        @id @default(uuid(7)) @db.Uuid
  code         String        @unique
  name         String
  description  String?
  featureKeys  String[]      @map("feature_keys")
  quotaDeltas  Json?         @map("quota_deltas")
  sort         Int           @default(0)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  addonPrices  AddonPrice[]
  tenantAddons TenantAddon[]

  @@map("addons")
}

model AddonPrice {
  id           String       @id @default(uuid(7)) @db.Uuid
  addonId      String       @map("addon_id") @db.Uuid
  addon        Addon        @relation(fields: [addonId], references: [id], onDelete: Cascade)
  billingCycle BillingCycle @map("billing_cycle")
  currency     String       @default("XOF") @db.Char(3)
  amount       BigInt
  validFrom    DateTime?    @map("valid_from") @db.Date
  validTo      DateTime?    @map("valid_to") @db.Date
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([addonId])
  @@map("addon_prices")
}

model TenantAddon {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  addonId       String            @map("addon_id") @db.Uuid
  addon         Addon             @relation(fields: [addonId], references: [id])
  startsAt      DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime?         @map("ends_at") @db.Timestamptz(6)
  status        TenantAddonStatus @default(ACTIVE)
  priceSnapshot Json?             @map("price_snapshot")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([addonId])
  @@map("tenant_addons")
}

model Coupon {
  id                String             @id @default(uuid(7)) @db.Uuid
  code              String             @unique
  type              CouponType
  value             Decimal            @db.Decimal(18, 4)
  duration          Int?
  maxRedemptions    Int?               @map("max_redemptions")
  redeemedCount     Int                @default(0) @map("redeemed_count")
  eligiblePlans     String[]           @map("eligible_plans")
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz(6)
