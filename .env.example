# Copy to .env.development (never commit real secrets)
NODE_ENV=development
PORT=4000
APP_BASE_DOMAIN=localhost

# PostgreSQL (app role is subject to RLS; admin role bypasses it for migrations/platform jobs)
# DATABASE_URL_ADMIN = owner role (SUPERUSER or BYPASSRLS): migrations, /api/v1/admin/*, platform jobs.
# DATABASE_URL       = hm_app (NOBYPASSRLS), created by the migrations without password:
#   after `pnpm --filter @hm/database db:deploy`, run once: ALTER ROLE hm_app PASSWORD 'hm_dev_password';
POSTGRES_PASSWORD=hm_dev_password
DATABASE_URL=postgresql://hm_app:hm_dev_password@localhost:5432/hm
DATABASE_URL_ADMIN=postgresql://hm:hm_dev_password@localhost:5432/hm

REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hm-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# SMTP (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hotel.local

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

GOTENBERG_URL=http://localhost:3000
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
